# ==============================================================================
# LOVA MINING — ENVIRONMENT VARIABLES TEMPLATE
# Never commit real secrets to source control.
# ==============================================================================

# Server / App URL
APP_URL="http://localhost:3000"
PORT="3000"

# Telegram Mini App Bot (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Set to "true" ONLY for local/preview testing outside Telegram WebApp.
# Must be "false" in production so only HMAC-verified Telegram initData is accepted.
TELEGRAM_ALLOW_DEV_PREVIEW="true"

# Supabase PostgreSQL (SERVER-ONLY SERVICE ROLE KEY)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server Session & Admin Security (SERVER-ONLY)
# Generate random 32+ char strings in production (e.g. openssl rand -hex 32)
SESSION_SECRET=""
ADMIN_BOOTSTRAP_SECRET=""
# Comma-separated Telegram User IDs allowed to access Admin Control Center
ADMIN_TELEGRAM_IDS=""

# TON Blockchain & 0.05 GRAM Jetton Verification (SERVER-ONLY API KEY)
# Leave GRAM_JETTON_MASTER_ADDRESS empty until verified mainnet address is confirmed.
# Verification remains safely disabled until master address, decimals, and admin wallet are set.
GRAM_JETTON_MASTER_ADDRESS=""
GRAM_JETTON_DECIMALS="9"
ADMIN_TON_WALLET_ADDRESS=""
TON_API_ENDPOINT="https://tonapi.io/v2"
TON_API_KEY=""

# LOVA Jetton Contract (Empty until token deployment — app uses DEMO BALANCES until set)
LOVA_JETTON_MASTER_ADDRESS=""
